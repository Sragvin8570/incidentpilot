FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app
RUN pip install --no-cache-dir "kubernetes>=31,<33"
RUN useradd --no-create-home --uid 10001 executor
COPY app/executor/__init__.py /app/app/executor/__init__.py
COPY app/executor/runtime.py /app/app/executor/runtime.py
USER 10001:10001

ENTRYPOINT ["python", "-m", "app.executor.runtime"]
